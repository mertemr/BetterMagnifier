<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!-- ===================================================================== -->
  <!-- BetterMagnifier uygulama manifesti                                    -->
  <!-- ===================================================================== -->

  <assemblyIdentity type="win32"
                    name="BetterMagnifier"
                    version="0.1.0.0"
                    processorArchitecture="*" />

  <!--
    ── Yonetici yetkisi NEREDE TANIMLI ──

    Burada DEGIL. requestedExecutionLevel'i bu dosyaya yazmak
    "manifest authoring error c1010001: Values of attribute level not equal in
    different manifest snippets" ile derlemeyi dusuruyor: MSBuild kendi
    manifest parcasini asInvoker ile uretiyor ve mt.exe iki farkli degeri
    birlestiremiyor.

    Dogru yer vcxproj: <Link><UACExecutionLevel>RequireAdministrator.
    Boylece uretilen manifest bastan dogru doguyor, birlestirme catismasi yok.

    NE KAZANIYORUZ:
      Yukseltilmis process daha yuksek integrity seviyesinde calisiyor.
      Low-level hook'lar (WH_KEYBOARD_LL / WH_MOUSE_LL) kendisinden DUSUK
      integrity'li pencerelerin girdisini gorebiliyor ve yutabiliyor. Normal
      seviyede Windows Magnifier'in Win+arti kisayolunu yutamiyorduk;
      yukseltilmis halde sansimiz daha yuksek.

    NE KAZANMIYORUZ — ONEMLI:
      Yukseltme UIAccess DEGIL. MagSetFullscreenTransform gibi UIAccess
      isteyen API'ler yine calismaz; onun icin imzali exe + guvenilir konumda
      kurulum + uiAccess="true" gerekiyor.

    BEDELI:
      - Her acilista UAC penceresi
      - Yukseltilmemis uygulamalardan surukle-birak calismaz (UIPI)
      - Windows ile otomatik baslatma (HKCU Run) yukseltilmis process icin
        sessizce calismaz; Task Scheduler ile "en yuksek ayricaliklarla"
        gorev olusturmak gerekir
  -->

  <!-- ── Desteklenen Windows surumleri ── -->
  <!--
    Bu blok olmadan Windows uygulamayi "uyumluluk modunda" calistirip bazi
    API'lerin davranisini eskitiyor. Windows 10/11 GUID'i sart.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    DPI bilincini manifest'te TANIMLAMIYORUZ.
    main.cpp SetProcessDpiAwarenessContext(PER_MONITOR_AWARE_V2) ile kod
    tarafinda ayarliyor. Ikisini birden belirtmek catisma yaratir; manifest
    kazanir ve koddaki cagri sessizce basarisiz olur.
  -->

</assembly>
