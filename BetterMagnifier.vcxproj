       daha derlemeye baslamadan patliyor.
       Python analojisi: requirements.txt'te "requests==2.28.1" yerine
       "requests" yazmak — ortamda ne varsa onunla calis. -->
  <PropertyGroup Label="Configuration">
    <PlatformToolset Condition="'$(PlatformToolset)'==''">$(DefaultPlatformToolset)</PlatformToolset>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
