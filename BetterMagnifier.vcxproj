  <!-- The bootstrap import library lives in the foundation sub-package, whose
       version differs from the main package and is chosen transitively. That
       package's .props adds the include path but NOT the lib path, so we point
       at it by hand. Bump this when the Microsoft.WindowsAppSDK version below
       changes: windowsappsdk 1.8.250916003 -> foundation 1.8.250906002.
       (A glob was tried: item lists inside ItemDefinitionGroup are illegal,
       MSB4164.) WasdkPlatform maps MSBuild's "Win32" onto the package's "x86".
       This has to sit AFTER Microsoft.Cpp.props: NuGetPackageRoot comes from the
       generated nuget props and is still empty before that import. -->
  <PropertyGroup>
    <WasdkFoundationVersion>1.8.250906002</WasdkFoundationVersion>
    <WasdkPlatform Condition="'$(Platform)'=='Win32'">x86</WasdkPlatform>
    <WasdkPlatform Condition="'$(WasdkPlatform)'==''">$(Platform)</WasdkPlatform>
    <WasdkLibDir>$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\$(WasdkFoundationVersion)\lib\native\$(WasdkPlatform)</WasdkLibDir>
  </PropertyGroup>

  <!-- Debug Win32 -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;_DEBUG;UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- GECICI: AsInvoker, gelistirme/test icin. Elevation'in getirdigi
           surekli UAC penceresi bazi pencere/etkilesim testlerini engelliyordu.
           Yayin oncesi RequireAdministrator'a geri alinacak (bkz. docs/STATUS.md).
           Deger burada, manifest'te degil: mt.exe iki farkli level degerini
           birlestiremiyor (c1010001). Bkz. src\app.manifest -->
      <UACExecutionLevel>AsInvoker</UACExecutionLevel>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- windowsapp.lib: C++/WinRT runtime.
           Microsoft.WindowsAppRuntime.Bootstrap.lib: the auto-initializer. -->
      <AdditionalDependencies>d3d11.lib;dxgi.lib;d2d1.lib;dwrite.lib;dxguid.lib;d3dcompiler.lib;Shcore.lib;Wtsapi32.lib;dwmapi.lib;windowsapp.lib;Microsoft.WindowsAppRuntime.Bootstrap.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(WasdkLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- Release Win32 -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;NDEBUG;UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
