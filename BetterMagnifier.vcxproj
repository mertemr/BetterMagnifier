  <ItemGroup>
    <!-- Pinned to the 1.8 line on purpose: 2.3.1 access-violated inside
         Application::Start, and the runtime installed on the dev machine is
         Microsoft.WindowsAppRuntime.1.8. A newer package raises the minimum
         version the auto-initializer asks for, and then no runtime is found. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260715.1" />
  </ItemGroup>

  <!-- Anything C++/WinRT generates is compiled without our precompiled header
       and without warnings-as-error: it neither includes pch.h nor was written
       to survive Level4. Our own files still have to be clean.
       A Condition on %(Filename) inside ItemDefinitionGroup is illegal here
       (MSB4190), so the metadata is stamped on just before the compile. -->
  <Target Name="RelaxGeneratedWinRTSources" BeforeTargets="ClCompile">
    <ItemGroup>
      <ClCompile Condition="$([System.String]::Copy('%(Identity)').Contains('Generated Files'))">
        <TreatWarningAsError>false</TreatWarningAsError>
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
      </ClCompile>
    </ItemGroup>
  </Target>

