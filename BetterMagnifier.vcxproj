    <RootNamespace>BetterMagnifier</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>

    <!-- ── Windows App SDK / WinUI 3, for the control panel only ──
         Every one of these was needed to get an XAML island up; the reasoning
         is recorded in spike/xaml-island-thread/FINDINGS.md.

         ResolveNuGetPackages=false: PackageReference in a C++ project drags in
         the old ResolveNuGetPackageAssets task, which looks for a managed
         TargetFramework in project.assets.json and fails with "the sequence
         contains no elements". The .props/.targets we actually need are
         imported separately.

         WindowsPackageType=None: turns on the SDK auto-initializer, which runs
         the bootstrapper in the right order while the module loads. Calling
         MddBootstrapInitialize by hand resolves the framework package but does
         not finish initialising WinUI.

         UseWinUI: enables the WinUI targets and resources.pri generation. -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- Toolset'i sabit bir surume (v143) pinlemiyoruz. Kurulu Visual Studio
